{
  "manifest_version": 3,
  "name": "网页双页切换器",
  "version": "1.3.0",
  "description": "用全局快捷键在两个自定义网页之间切换，并自动暂停另一边。",
  "key": "",
  "permissions": ["scripting", "storage", "nativeMessaging", "alarms"],
  "host_permissions": ["*://*.douyin.com/*", "*://*.bilibili.com/*", "*://b23.tv/*"],
  "optional_host_permissions": ["*://*/*", "file:///*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-player": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Alt+Shift+Y"
      },
      "description": "在页面 A 和页面 B 之间切换并播放"
    },
    "focus-target-a": {
      "description": "切换到页面 A 并播放"
    },
    "focus-target-b": {
      "description": "切换到页面 B 并播放"
    }
  },
  "action": {
    "default_popup": "options.html",
    "default_title": "网页双页切换器"
  }
}
